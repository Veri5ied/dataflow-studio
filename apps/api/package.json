    "@dataflow/utils": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.6.12",
    "ioredis": "^5.4.2",
    "openid-client": "^6.8.2",
    "pg": "^8.19.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
