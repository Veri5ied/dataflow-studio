    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @dataflow/utils lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @dataflow/utils test"
      }
    }
  }
}
